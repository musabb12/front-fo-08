# Public site URL used for metadata, SEO, and server-side fetches
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS admin login (server-side only — never expose in the UI)
CMS_ADMIN_USERNAME=SD-Developer
CMS_ADMIN_PASSWORD=change-me-to-a-strong-password

# JWT signing secret (min 32 characters) — required in production
JWT_SECRET=change-me-to-a-long-random-jwt-secret-key

# PostgreSQL — required for production persistence
# Local: docker compose up -d
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms

# Cloudflare R2 (image uploads from CMS admin)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-domain.r2.dev
